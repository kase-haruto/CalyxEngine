///////////////////////////////////////////////////////////////////////////////
//                          cbuffers
///////////////////////////////////////////////////////////////////////////////
cbuffer PickingCB : register(b2) {
    uint objectID;
}

////////////////////////////////////////////////////////////////////////////////
//                            出力
///////////////////////////////////////////////////////////////////////////////
float4 main() : SV_Target {
    // オブジェクトIDをカラーとして出力
   uint r = (objectID >>  0) & 0xFF;
    uint g = (objectID >>  8) & 0xFF;
    uint b = (objectID >> 16) & 0xFF;

    return float4(r, g, b, 255) / 255.0;
}