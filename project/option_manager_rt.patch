+void OptionManager::PrepareSpriteRender(ID3D12GraphicsCommandList* cmd, PipelineService* pso) {
+    if (!previewVisible_ || !modelPreview_ || !previewRenderer_ ||
+        !previewCamera_ || !previewTransform_ || !GetStaticModel()) {
+        return;
+    }
+
+    auto* context = SceneContext::Current();
+    if (!context || !context->GetLightLibrary()) {
+        return;
+    }
+
+    previewCamera_->AlwaysUpdate(0.0f);
+    previewTransform_->Update();
+    previewRenderer_->BeginFrame();
+    previewRenderer_->RegisterStatic(
+        GetStaticModel(), *previewTransform_, BillboardMode::None, nullptr);
+    previewRenderer_->PreCullAndBatch(previewCamera_.get(), false);
+
+    modelPreview_->Begin3D(cmd);
+    previewRenderer_->DrawAll(
+        cmd,
+        GraphicsGroup::GetInstance()->GetDevice().Get(),
+        modelPreview_->GetRenderTarget(),
+        pso,
+        context->GetLightLibrary(),
+        nullptr,
+        ModelRenderPhase::All,
+        previewCamera_.get());
+    modelPreview_->End3D(cmd);
+}
